---
import { Image } from "astro:assets";
import avatar from "../assets/images/avatar_model.png";
import HeroCanvas from "./HeroCanvas.tsx";
import HeroCursor from "./HeroCursor.tsx";

interface Props {
  name?: string;
  role?: string;
  bio?: string;
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  name = "Gabriel Gobbi",
  role = "Desenvolvedor & Designer",
  bio = "Construo interfaces com personalidade — tipografia forte, cores chapadas, sombras hard. Foco em produto, performance e detalhe.",
  ctaHref = "#timeline",
  ctaLabel = "Ver timeline",
} = Astro.props;
---

<section
  aria-labelledby="hero-title"
  data-hero-cursor
  class="relative py-12 md:py-20"
>
  <div
    class="grid grid-cols-1 gap-10 md:grid-cols-[minmax(0,22rem)_1fr] md:items-center md:gap-14"
  >
    <div class="relative mx-auto w-full max-w-sm md:mx-0">
      <div
        class="border-brutal-thick relative bg-brutal-yellow shadow-brutal-xl"
      >
        <Image
          src={avatar}
          alt={`Foto de ${name}`}
          widths={[320, 480, 640, 800, 960]}
          sizes="(min-width: 768px) 22rem, 90vw"
          class="block aspect-square w-full object-cover"
          loading="eager"
        />
      </div>

      <div
        data-3d-slot
        data-state="loading"
        aria-hidden="true"
        class="pointer-events-none absolute -right-6 -top-6 z-10 hidden h-24 w-24 md:block lg:-right-10 lg:-top-10 lg:h-32 lg:w-32"
      >
        <div class="brutal-skeleton" aria-hidden="true"></div>
        <HeroCanvas client:visible />
      </div>
    </div>

    <div class="flex flex-col gap-5">
      <p
        class="font-display text-sm uppercase tracking-widest text-brutal-magenta"
      >
        Olá, eu sou
      </p>
      <h1 id="hero-title" class="leading-none">{name}</h1>
      <p class="font-display text-xl uppercase tracking-tight md:text-2xl">
        {role}
      </p>
      <p class="max-w-xl text-lg">{bio}</p>

      <div class="mt-5 flex md:mt-8">
        <a href={ctaHref} class="btn-brutal btn-brutal-hover">
          {ctaLabel}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>

  <HeroCursor client:idle />
</section>
