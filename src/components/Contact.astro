---
// Contact — fechamento da página. Card brutalista grande com CTA mailto
// principal e linha de links sociais (GitHub, LinkedIn). Sem formulário/
// backend: contato direto via cliente de email do usuário.
//
// Efeito visual: sombra hard offset (positiva, canto inferior-direito);
// no hover, a sombra inverte para o canto oposto (negativa, superior-
// esquerdo), respeitando prefers-reduced-motion.

interface Props {
  email?: string;
  githubHref?: string;
  linkedinHref?: string;
}

const {
  email = "gabgobs@gmail.com",
  githubHref = "https://github.com/Gobbi1108",
  linkedinHref = "https://www.linkedin.com/in/gabriel-gobbi-2459b423b/",
} = Astro.props;

const mailto = `mailto:${email}`;
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="contact relative py-20 md:py-28"
>
  <article data-reveal class="contact-card border-brutal-thick bg-brutal-yellow text-brutal-black mx-auto flex max-w-4xl flex-col items-start gap-8 p-8 sm:p-12 md:p-16">
    <p class="font-display text-sm uppercase tracking-[0.3em] text-brutal-pink">
      Contato
    </p>

    <h2
      id="contact-title"
      class="font-display text-5xl uppercase leading-none sm:text-6xl md:text-7xl"
    >
      Vamos conversar
    </h2>

    <p class="max-w-2xl text-lg md:text-xl">
      Tem ideia, proposta ou só quer trocar uma figurinha? Me manda um email —
      respondo rápido.
    </p>

    <a href={mailto} class="btn-brutal btn-brutal-hover bg-brutal-pink text-brutal-paper text-lg md:text-xl">
      {email}
      <span aria-hidden="true">→</span>
    </a>

    <div class="border-t-2 border-brutal-black w-full pt-6">
      <p class="font-mono text-xs uppercase tracking-widest opacity-70 mb-4">
        Também estou em
      </p>
      <ul class="flex flex-wrap gap-4">
        <li>
          <a
            href={githubHref}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link border-brutal bg-brutal-paper inline-flex items-center gap-2 px-4 py-2 font-display uppercase tracking-wide"
            aria-label="GitHub (abre em nova aba)"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" fill="currentColor">
              <path d="M12 .5C5.73.5.75 5.48.75 11.75c0 4.96 3.22 9.16 7.69 10.65.56.1.77-.24.77-.54v-1.9c-3.13.68-3.79-1.51-3.79-1.51-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.68.08-.68 1.13.08 1.72 1.16 1.72 1.16 1 1.72 2.63 1.22 3.27.93.1-.73.39-1.22.71-1.5-2.5-.28-5.13-1.25-5.13-5.57 0-1.23.44-2.24 1.16-3.03-.12-.29-.5-1.43.11-2.98 0 0 .95-.3 3.11 1.16.9-.25 1.87-.38 2.83-.38s1.93.13 2.83.38c2.16-1.46 3.11-1.16 3.11-1.16.61 1.55.23 2.69.11 2.98.72.79 1.16 1.8 1.16 3.03 0 4.33-2.63 5.28-5.14 5.56.4.35.76 1.03.76 2.08v3.08c0 .3.21.65.78.54 4.47-1.49 7.68-5.69 7.68-10.65C23.25 5.48 18.27.5 12 .5z" />
            </svg>
            GitHub
          </a>
        </li>
        <li>
          <a
            href={linkedinHref}
            target="_blank"
            rel="noopener noreferrer"
            class="social-link border-brutal bg-brutal-paper inline-flex items-center gap-2 px-4 py-2 font-display uppercase tracking-wide"
            aria-label="LinkedIn (abre em nova aba)"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM3.56 20.45h3.56V9H3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
            </svg>
            LinkedIn
          </a>
        </li>
      </ul>
    </div>
  </article>
</section>

<style>
  /* Card grande com sombra hard offset; hover inverte a direção da sombra
     do canto inferior-direito para o superior-esquerdo. Sem translate, só
     a sombra se move — diferente do btn-brutal-hover, que move o elemento. */
  .contact-card {
    box-shadow: var(--shadow-brutal-xl);
    transition: box-shadow 160ms ease;
  }

  .contact-card:hover {
    box-shadow: var(--shadow-brutal-xl-inv);
  }

  /* Social links: sombra pequena que também inverte no hover. */
  .social-link {
    box-shadow: var(--shadow-brutal-sm);
    transition: box-shadow 120ms ease;
  }

  .social-link:hover {
    box-shadow: var(--shadow-brutal-sm-inv);
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .social-link {
      transition: none;
    }
    .contact-card:hover {
      box-shadow: var(--shadow-brutal-xl);
    }
    .social-link:hover {
      box-shadow: var(--shadow-brutal-sm);
    }
  }
</style>
