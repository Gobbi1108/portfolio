---
// Timeline — estrutura base (PR #4) + personagem Lottie (PR #5) + scroll-driven (PR #6)
// + transições visuais entre cenários (PR #9).
//
// 4 cenas verticais (baby → child → scout → tech), cada uma full-bleed com
// cor distinta da paleta brutalista. Cada cena traz 3 elementos decorativos
// inline em SVG (props) posicionados nos cantos, coerentes com a fase. Os
// props ficam ocultos por padrão e revelam quando o personagem cruza o centro
// da cena, controlados via ScrollTrigger em TimelineScrollController.
//
// Uma "janela do personagem" fica sticky ao centro da viewport e atravessa
// todas as cenas; dentro dela vive o player Lottie (TimelineCharacter).
//
// Acessibilidade: props são `aria-hidden` (decorativos). Em prefers-reduced-
// motion: reduce, props aparecem estáticos (sem transição), via media query.

import TimelineCharacter from "./TimelineCharacter.tsx";
import TimelineScrollController from "./TimelineScrollController.tsx";

interface Scene {
  id: string;
  index: string;
  title: string;
  kicker: string;
  bg: string;
  fg: string;
  placeholderBg: string;
}

const scenes: Scene[] = [
  {
    id: "scene-baby",
    index: "01",
    title: "Bebê",
    kicker: "Primeiros traços",
    bg: "bg-brutal-paper",
    fg: "text-brutal-ink",
    placeholderBg: "bg-brutal-bone",
  },
  {
    id: "scene-child",
    index: "02",
    title: "Criança",
    kicker: "Curiosidade solta",
    bg: "bg-brutal-yellow",
    fg: "text-brutal-ink",
    placeholderBg: "bg-brutal-paper",
  },
  {
    id: "scene-scout",
    index: "03",
    title: "Escoteiro",
    kicker: "Mundo lá fora",
    bg: "bg-brutal-lime",
    fg: "text-brutal-ink",
    placeholderBg: "bg-brutal-paper",
  },
  {
    id: "scene-tech",
    index: "04",
    title: "Tech",
    kicker: "Onde estou agora",
    bg: "bg-brutal-blue",
    fg: "text-brutal-paper",
    placeholderBg: "bg-brutal-black",
  },
];

// Classes compartilhadas entre todos os props. Posicionamento e índice de
// stagger vêm por slot (tl/tr/bl/br) inline em cada wrapper.
const propBase = "scene-prop absolute pointer-events-none select-none";
const propSize = "w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24";
const slotTL = "top-6 left-6 sm:top-10 sm:left-10";
const slotTR = "top-6 right-6 sm:top-10 sm:right-10";
const slotBL = "bottom-10 left-6 sm:bottom-14 sm:left-10";
const slotBR = "bottom-10 right-6 sm:bottom-14 sm:right-10";
---

<section
  id="timeline"
  aria-label="Linha do tempo"
  class="timeline relative"
>
  <!--
    Stage sticky com a janela do personagem. Fica colado no topo da
    viewport e atravessa todas as cenas. Pointer-events none para não
    bloquear cliques nas cenas abaixo.
  -->
  <div
    class="character-stage pointer-events-none sticky top-0 z-20 flex h-dvh items-center justify-center"
    aria-hidden="true"
  >
    <div
      data-character-slot
      class="character-window border-brutal-thick bg-brutal-paper shadow-brutal-xl flex aspect-square w-40 items-center justify-center overflow-hidden sm:w-48 md:w-56 lg:w-64"
    >
      <TimelineCharacter client:visible />
    </div>
  </div>

  <!--
    Cenas empilhadas. Margem negativa de 100dvh puxa a primeira cena para
    cima da stage sticky, criando o efeito de "personagem sobre cenário".
    dvh (dynamic viewport height) mantém alinhamento no mobile quando a
    barra de endereço colapsa/expande.
  -->
  <div class="scenes scenes-bleed relative z-10">
    {
      scenes.map((scene) => (
        <article
          id={scene.id}
          data-scene={scene.id}
          class={`scene relative flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden px-6 py-24 ${scene.bg} ${scene.fg}`}
          aria-labelledby={`${scene.id}-title`}
        >
          <header class="mb-10 flex flex-col items-center gap-2 text-center">
            <p class="font-display text-sm uppercase tracking-[0.3em] opacity-70">
              {scene.index} — {scene.kicker}
            </p>
            <h2
              id={`${scene.id}-title`}
              class="font-display text-6xl uppercase leading-none sm:text-7xl md:text-8xl"
            >
              {scene.title}
            </h2>
          </header>

          <div
            data-scene-slot
            class={`border-brutal-thick flex aspect-[4/3] w-full max-w-2xl items-center justify-center ${scene.placeholderBg} ${scene.fg} shadow-brutal-lg`}
            role="img"
            aria-label={`Placeholder do cenário ${scene.title}`}
          >
            <span class="font-display text-lg uppercase tracking-widest opacity-80">
              [cenário]
            </span>
          </div>

          {/* Props decorativos por cenário. Hidden até `.scene.is-active`. */}
          {scene.id === "scene-baby" && (
            <>
              <div
                data-scene-prop
                style="--i:0"
                class={`${propBase} ${propSize} ${slotTL}`}
                aria-hidden="true"
              >
                {/* Chocalho */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <circle cx="32" cy="22" r="14" fill="#ff4fa8" stroke="#0a0a0a" stroke-width="3" />
                  <circle cx="32" cy="22" r="4" fill="#0a0a0a" />
                  <rect x="29" y="34" width="6" height="22" fill="#0a0a0a" />
                  <circle cx="32" cy="58" r="4" fill="#2b6cff" stroke="#0a0a0a" stroke-width="2" />
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:1"
                class={`${propBase} ${propSize} ${slotTR}`}
                aria-hidden="true"
              >
                {/* Mamadeira */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <rect x="20" y="14" width="24" height="40" fill="#2b6cff" stroke="#0a0a0a" stroke-width="3" />
                  <rect x="26" y="6" width="12" height="10" fill="#ffd400" stroke="#0a0a0a" stroke-width="3" />
                  <line x1="20" y1="28" x2="44" y2="28" stroke="#0a0a0a" stroke-width="2" />
                  <line x1="20" y1="38" x2="44" y2="38" stroke="#0a0a0a" stroke-width="2" />
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:2"
                class={`${propBase} ${propSize} ${slotBR}`}
                aria-hidden="true"
              >
                {/* Berço — grades */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <rect x="6" y="20" width="52" height="36" fill="#ece6d6" stroke="#0a0a0a" stroke-width="3" />
                  <line x1="16" y1="20" x2="16" y2="56" stroke="#0a0a0a" stroke-width="3" />
                  <line x1="26" y1="20" x2="26" y2="56" stroke="#0a0a0a" stroke-width="3" />
                  <line x1="36" y1="20" x2="36" y2="56" stroke="#0a0a0a" stroke-width="3" />
                  <line x1="46" y1="20" x2="46" y2="56" stroke="#0a0a0a" stroke-width="3" />
                </svg>
              </div>
            </>
          )}

          {scene.id === "scene-child" && (
            <>
              <div
                data-scene-prop
                style="--i:0"
                class={`${propBase} ${propSize} ${slotTL}`}
                aria-hidden="true"
              >
                {/* Pião */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <polygon points="10,20 54,20 32,54" fill="#ff4fa8" stroke="#0a0a0a" stroke-width="3" stroke-linejoin="round" />
                  <rect x="28" y="6" width="8" height="16" fill="#0a0a0a" />
                  <circle cx="32" cy="58" r="3" fill="#0a0a0a" />
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:1"
                class={`${propBase} ${propSize} ${slotTR}`}
                aria-hidden="true"
              >
                {/* Bloco ABC */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <rect x="10" y="10" width="44" height="44" fill="#2b6cff" stroke="#0a0a0a" stroke-width="3" />
                  <text
                    x="32"
                    y="44"
                    text-anchor="middle"
                    font-family="Archivo Black, sans-serif"
                    font-size="28"
                    fill="#faf7f0"
                  >
                    A
                  </text>
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:2"
                class={`${propBase} ${propSize} ${slotBL}`}
                aria-hidden="true"
              >
                {/* Balão */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <ellipse cx="32" cy="24" rx="16" ry="20" fill="#ff4fa8" stroke="#0a0a0a" stroke-width="3" />
                  <polygon points="28,42 36,42 32,48" fill="#0a0a0a" />
                  <path d="M32 48 Q28 54 32 60" stroke="#0a0a0a" stroke-width="2" fill="none" />
                </svg>
              </div>
            </>
          )}

          {scene.id === "scene-scout" && (
            <>
              <div
                data-scene-prop
                style="--i:0"
                class={`${propBase} ${propSize} ${slotTL}`}
                aria-hidden="true"
              >
                {/* Flor-de-lis */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <path
                    d="M32 6 L40 22 L50 18 L42 32 L52 38 L32 44 L12 38 L22 32 L14 18 L24 22 Z"
                    fill="#ff4fa8"
                    stroke="#0a0a0a"
                    stroke-width="3"
                    stroke-linejoin="round"
                  />
                  <rect x="12" y="44" width="40" height="6" fill="#0a0a0a" />
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:1"
                class={`${propBase} ${propSize} ${slotTR}`}
                aria-hidden="true"
              >
                {/* Bússola */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <circle cx="32" cy="32" r="24" fill="#faf7f0" stroke="#0a0a0a" stroke-width="3" />
                  <polygon points="32,12 28,32 32,32" fill="#ff4fa8" stroke="#0a0a0a" stroke-width="2" stroke-linejoin="round" />
                  <polygon points="32,52 32,32 36,32" fill="#0a0a0a" />
                  <circle cx="32" cy="32" r="3" fill="#0a0a0a" />
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:2"
                class={`${propBase} ${propSize} ${slotBR}`}
                aria-hidden="true"
              >
                {/* Fogueira */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <path
                    d="M32 6 Q44 22 32 34 Q20 22 32 6 Z"
                    fill="#ff4fa8"
                    stroke="#0a0a0a"
                    stroke-width="3"
                    stroke-linejoin="round"
                  />
                  <path
                    d="M32 18 Q40 28 32 36 Q24 28 32 18 Z"
                    fill="#ffd400"
                    stroke="#0a0a0a"
                    stroke-width="2"
                  />
                  <line x1="10" y1="52" x2="54" y2="58" stroke="#0a0a0a" stroke-width="4" />
                  <line x1="54" y1="52" x2="10" y2="58" stroke="#0a0a0a" stroke-width="4" />
                </svg>
              </div>
            </>
          )}

          {scene.id === "scene-tech" && (
            <>
              <div
                data-scene-prop
                style="--i:0"
                class={`${propBase} ${propSize} ${slotTL}`}
                aria-hidden="true"
              >
                {/* Laptop */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <rect x="10" y="14" width="44" height="30" fill="#0a0a0a" stroke="#0a0a0a" stroke-width="3" />
                  <rect x="14" y="18" width="36" height="22" fill="#b6ff3a" />
                  <text
                    x="32"
                    y="34"
                    text-anchor="middle"
                    font-family="ui-monospace, Menlo, monospace"
                    font-size="14"
                    font-weight="700"
                    fill="#0a0a0a"
                  >
                    {">_"}
                  </text>
                  <rect x="4" y="44" width="56" height="6" fill="#faf7f0" stroke="#0a0a0a" stroke-width="3" />
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:1"
                class={`${propBase} ${propSize} ${slotTR}`}
                aria-hidden="true"
              >
                {/* Chaves { } */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <text
                    x="32"
                    y="50"
                    text-anchor="middle"
                    font-family="Archivo Black, sans-serif"
                    font-size="56"
                    fill="#ffd400"
                    stroke="#0a0a0a"
                    stroke-width="2"
                  >
                    {"{ }"}
                  </text>
                </svg>
              </div>
              <div
                data-scene-prop
                style="--i:2"
                class={`${propBase} ${propSize} ${slotBL}`}
                aria-hidden="true"
              >
                {/* Cursor / barras de código */}
                <svg viewBox="0 0 64 64" class="block h-full w-full">
                  <rect x="14" y="10" width="8" height="44" fill="#ff4fa8" stroke="#0a0a0a" stroke-width="3" />
                  <rect x="28" y="10" width="8" height="44" fill="#b6ff3a" stroke="#0a0a0a" stroke-width="3" />
                  <rect x="42" y="10" width="8" height="44" fill="#ffd400" stroke="#0a0a0a" stroke-width="3" />
                </svg>
              </div>
            </>
          )}
        </article>
      ))
    }
  </div>

  <TimelineScrollController client:visible />
</section>

<style>
  /* Full-bleed: escapa do container max-w-6xl do BaseLayout. O bloqueio
     de scroll horizontal global vive em `global.css` (`html { overflow-x: clip }`),
     que evita barra horizontal no desktop por causa do scrollbar reservado. */
  .timeline {
    margin-inline: calc(50% - 50vw);
    width: 100vw;
  }

  /* Puxa as cenas sob a stage sticky. dvh para mobile não desalinhar. */
  .scenes-bleed {
    margin-top: -100dvh;
  }

  /* Props decorativos: ocultos por padrão, revelam quando a cena está ativa.
     `is-active` é alternada pelo TimelineScrollController via ScrollTrigger
     enquanto o personagem (centro da viewport) está sobre a cena.
     Stagger por inline `--i` (0..2) para ordenar a entrada. Animação curta
     coerente com a estética brutalista (sem easing suave longo). */
  .scene-prop {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 180ms linear,
      transform 180ms linear;
    transition-delay: calc(var(--i, 0) * 70ms);
  }

  .scene.is-active .scene-prop {
    opacity: 1;
    transform: translateY(0);
  }

  /* Sem ScrollTrigger ativo (reduced-motion), props aparecem estáticos. */
  @media (prefers-reduced-motion: reduce) {
    .scene-prop {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
