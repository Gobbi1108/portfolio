---
// Timeline — estrutura base (PR #4) + personagem Lottie (PR #5)
// + transições visuais entre cenários (PR #7).
//
// 4 cenas verticais (baby → child → scout → tech), cada uma full-bleed com
// cor distinta da paleta brutalista. Cada cena agora carrega 2–3 props SVG
// inline coerentes com a fase (chocalho/berço, giz/bloco/estrela, flor-de-lis/
// bússola/fogueira, laptop/{}/prompt). Entrada/saída animadas via GSAP
// ScrollTrigger conforme a janela do personagem (sticky) atravessa a cena.
// Sem libs novas — gsap já está nas deps.
//
// Roadmap:
//   PR #6: scroll-driven — sincronizar progresso da cena com frame do Lottie.
//          O player já expõe window.__timelineCharacter.goToAndStop para isso.
//   PR #8: textos finais de cada fase.

import TimelineCharacter from "./TimelineCharacter.tsx";
import BabyDecor from "./scenery/BabyDecor.astro";
import ChildDecor from "./scenery/ChildDecor.astro";
import ScoutDecor from "./scenery/ScoutDecor.astro";
import TechDecor from "./scenery/TechDecor.astro";

interface Scene {
  id: "scene-baby" | "scene-child" | "scene-scout" | "scene-tech";
  index: string;
  title: string;
  kicker: string;
  bg: string;
  fg: string;
}

const scenes: Scene[] = [
  {
    id: "scene-baby",
    index: "01",
    title: "Bebê",
    kicker: "Primeiros traços",
    bg: "bg-brutal-paper",
    fg: "text-brutal-ink",
  },
  {
    id: "scene-child",
    index: "02",
    title: "Criança",
    kicker: "Curiosidade solta",
    bg: "bg-brutal-yellow",
    fg: "text-brutal-ink",
  },
  {
    id: "scene-scout",
    index: "03",
    title: "Escoteiro",
    kicker: "Mundo lá fora",
    bg: "bg-brutal-lime",
    fg: "text-brutal-ink",
  },
  {
    id: "scene-tech",
    index: "04",
    title: "Tech",
    kicker: "Onde estou agora",
    bg: "bg-brutal-blue",
    fg: "text-brutal-paper",
  },
];
---

<section
  id="timeline"
  aria-label="Linha do tempo"
  class="timeline relative"
>
  <!--
    Stage sticky com a janela do personagem. Fica colado no topo da
    viewport e atravessa todas as cenas. Pointer-events none para não
    bloquear cliques nas cenas abaixo.
  -->
  <div
    class="character-stage pointer-events-none sticky top-0 z-20 flex h-dvh items-center justify-center"
    aria-hidden="true"
  >
    <div
      data-character-slot
      class="character-window border-brutal-thick bg-brutal-paper shadow-brutal-xl flex aspect-square w-40 items-center justify-center overflow-hidden sm:w-48 md:w-56 lg:w-64"
    >
      <TimelineCharacter client:visible />
    </div>
  </div>

  <!--
    Cenas empilhadas. Margem negativa de 100dvh puxa a primeira cena para
    cima da stage sticky, criando o efeito de "personagem sobre cenário".
    dvh (dynamic viewport height) mantém alinhamento no mobile quando a
    barra de endereço colapsa/expande.
  -->
  <div class="scenes scenes-bleed relative z-10">
    {
      scenes.map((scene) => (
        <article
          id={scene.id}
          data-scene={scene.id}
          class={`scene relative flex min-h-dvh w-full flex-col items-center justify-center overflow-hidden px-6 py-24 ${scene.bg} ${scene.fg}`}
          aria-labelledby={`${scene.id}-title`}
        >
          {scene.id === "scene-baby" && <BabyDecor />}
          {scene.id === "scene-child" && <ChildDecor />}
          {scene.id === "scene-scout" && <ScoutDecor />}
          {scene.id === "scene-tech" && <TechDecor />}

          <header class="relative z-10 flex flex-col items-center gap-2 text-center">
            <p class="font-display text-sm uppercase tracking-[0.3em] opacity-70">
              {scene.index} — {scene.kicker}
            </p>
            <h2
              id={`${scene.id}-title`}
              class="font-display text-6xl uppercase leading-none sm:text-7xl md:text-8xl"
            >
              {scene.title}
            </h2>
          </header>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* Full-bleed: escapa do container max-w-6xl do BaseLayout. O bloqueio
     de scroll horizontal global vive em `global.css` (`html { overflow-x: clip }`),
     que evita barra horizontal no desktop por causa do scrollbar reservado. */
  .timeline {
    margin-inline: calc(50% - 50vw);
    width: 100vw;
  }

  /* Puxa as cenas sob a stage sticky. dvh para mobile não desalinhar. */
  .scenes-bleed {
    margin-top: -100dvh;
  }

  /* Estado inicial das props de cenário (PR #7). GSAP ScrollTrigger anima
     opacity/transform na entrada/saída da cena. Limitamos `will-change` aos
     itens visíveis para não inflar a memória de composição.

     Reduced motion: fallback CSS revela tudo sem animação. O script abaixo
     também bail-out via matchMedia. */
  [data-decor-item] {
    opacity: 0;
    transform: translateY(40px) scale(0.9);
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-decor-item] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  // PR #7 — anima props de cenário conforme o personagem (janela sticky)
  // atravessa cada cena. Sem libs novas: GSAP/ScrollTrigger já estão nas deps.
  // ScrollTrigger é importado dinamicamente para não bloquear o thread principal
  // do bundle inicial do <head>; Astro coloca este <script> como `type=module`
  // e executa após o DOM estar pronto.
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reduceMotion) {
    gsap.registerPlugin(ScrollTrigger);

    const scenes = document.querySelectorAll<HTMLElement>("[data-scene]");
    scenes.forEach((scene) => {
      const items = scene.querySelectorAll<HTMLElement>("[data-decor-item]");
      if (items.length === 0) return;

      // toggleActions: play / reverse / play / reverse cobre os 4 callbacks
      // (onEnter, onLeave, onEnterBack, onLeaveBack) — entra ao chegar,
      // sai ao deixar, em ambas direções de scroll.
      gsap.to(items, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.6,
        ease: "back.out(1.3)",
        stagger: 0.08,
        scrollTrigger: {
          trigger: scene,
          start: "top 75%",
          end: "bottom 25%",
          toggleActions: "play reverse play reverse",
        },
      });
    });
  }
</script>
