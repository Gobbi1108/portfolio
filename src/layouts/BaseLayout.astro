---
import "../styles/global.css";
// Preload das duas fontes que compõem a primeira tela. Sem isto o <h1> do
// hero reflui quando a fonte chega e o CLS medido vai a 0.247 (teto: 0.1).
// O `?url` faz o Vite devolver o caminho já com hash do build.
import archivoBlack from "@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url";
import inter from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Sem header, footer nem gutter: a página ocupa a viewport inteira (home). */
  bare?: boolean;
  /** Locale da página. Vira o atributo lang do <html> e o og:locale. */
  lang?: "pt-BR" | "en";
  /** Substitui a página inteira por "MOBILE" em tela pequena. Só as rotas de
      /void usam: o portfólio é responsivo de verdade (spec §9). */
  mobileGate?: boolean;
  /** Tira a rota do índice de busca. O easter egg não é conteúdo público. */
  noindex?: boolean;
  /** Versões em outro idioma desta mesma página. */
  alternate?: { hreflang: string; href: string }[];
}

const {
  title = "Portfolio",
  description = "Portfolio neubrutalista de Gabriel Gobbi — desenvolvedor e designer. Interfaces com tipografia forte, cores chapadas e sombras hard.",
  image = "/og.png",
  bare = false,
  lang = "pt-BR",
  mobileGate = false,
  noindex = false,
  alternate = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f0" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {
      alternate.map((alt) => (
        <link
          rel="alternate"
          hreflang={alt.hreflang}
          href={new URL(alt.href, Astro.site).toString()}
        />
      ))
    }
    <link rel="preload" as="font" type="font/woff2" href={archivoBlack} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={inter} crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gabriel Gobbi" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "pt_BR"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Capa do portfolio — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class="bg-brutal-paper text-brutal-ink font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:btn-brutal"
    >
      Pular para conteúdo
    </a>

    {
      /* Placeholder temporário das rotas do easter egg (spec §9): elas dependem
         de hover e não têm modelo mobile. O portfólio NÃO usa este gate.
         ponytail: enquanto durar, o crawler mobile não vê /void — que é
         justamente noindex, então o custo é zero. */
      mobileGate && <div class="mobile-gate">MOBILE</div>
    }

    {!bare && (
    <header
      class="border-brutal border-b-4 bg-brutal-paper sticky top-0 z-40"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a
          href="/"
          class="font-display text-2xl uppercase tracking-tight"
          aria-label="Início"
        >
          Portfolio<span class="text-brutal-magenta">.</span>
        </a>
        <nav aria-label="Principal" class="flex items-center gap-2">
          <a href="/" class="brutal-link px-3 py-2 font-display text-sm uppercase">Home</a>
          <a
            href="/styleguide"
            class="brutal-link px-3 py-2 font-display text-sm uppercase"
            >Styleguide</a
          >
        </nav>
      </div>
    </header>
    )}

    <main id="main" class={bare ? "" : "mx-auto max-w-6xl px-6 py-12"}>
      <slot />
    </main>

    {!bare && (
    <footer
      class="border-brutal border-t-4 bg-brutal-black text-brutal-paper mt-24"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="font-display uppercase tracking-wider">
          &copy; {new Date().getFullYear()} Portfolio
        </p>
        <p class="text-sm opacity-70">Construído com Astro + Tailwind v4.</p>
      </div>
    </footer>
    )}

  </body>
</html>
