---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Portfolio",
  description = "Portfolio neubrutalista de Gabriel Gobbi — desenvolvedor e designer. Interfaces com tipografia forte, cores chapadas e sombras hard.",
  image = "/og.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf7f0" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gabriel Gobbi" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Capa do portfolio — ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body class="bg-brutal-paper text-brutal-ink font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:btn-brutal"
    >
      Pular para conteúdo
    </a>

    <header
      class="border-brutal border-b-4 bg-brutal-paper sticky top-0 z-40"
    >
      <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
        <a
          href="/"
          class="font-display text-2xl uppercase tracking-tight"
          aria-label="Início"
        >
          Portfolio<span class="text-brutal-magenta">.</span>
        </a>
        <nav aria-label="Principal" class="flex items-center gap-2">
          <a href="/" class="brutal-link px-3 py-2 font-display text-sm uppercase">Home</a>
          <a
            href="/styleguide"
            class="brutal-link px-3 py-2 font-display text-sm uppercase"
            >Styleguide</a
          >
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-6 py-12">
      <slot />
    </main>

    <footer
      class="border-brutal border-t-4 bg-brutal-black text-brutal-paper mt-24"
    >
      <div
        class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <p class="font-display uppercase tracking-wider">
          &copy; {new Date().getFullYear()} Portfolio
        </p>
        <p class="text-sm opacity-70">Construído com Astro + Tailwind v4.</p>
      </div>
    </footer>

    <script>
      import { initSectionReveal } from "../lib/sectionReveal";
      initSectionReveal();
    </script>
  </body>
</html>
