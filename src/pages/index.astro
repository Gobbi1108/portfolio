---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Portfolio — em construção"
  description="Layout base e tokens neubrutalistas. Conteúdo real em breve."
>
  <section class="py-12">
    <p class="font-display text-sm uppercase tracking-widest text-brutal-pink">
      WIP
    </p>
    <h1 class="mt-2">Layout base pronto.</h1>
    <p class="mt-4 max-w-2xl text-lg">
      Tokens, tipografia e componentes definidos. Sem conteúdo real ainda — veja{
        " "
      }
      <a
        href="/styleguide"
        class="border-brutal-thick inline-block bg-brutal-yellow px-2 font-display uppercase"
        >/styleguide</a
      > para validar o sistema.
    </p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href="/styleguide"
        class="btn-brutal btn-brutal-hover"
      >
        Abrir Styleguide
      </a>
    </div>
  </section>
</BaseLayout>
